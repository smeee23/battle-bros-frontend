{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manifest.schema.json",
  "title": "BattleBros territory manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chainId",
    "deploymentId",
    "generation",
    "snapshot",
    "paths",
    "contentHash",
    "projectionVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "projectionVersion": {
      "const": 3
    },
    "chainId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "deploymentId": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockNumber",
        "blockHash",
        "timestamp"
      ],
      "properties": {
        "blockNumber": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "blockHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "timestamp": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gameState"
      ],
      "properties": {
        "gameState": {
          "type": "string",
          "pattern": "^snapshots/[a-zA-Z0-9/-]+\\.json$"
        }
      }
    }
  }
}
