{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "definitions.schema.json",
  "title": "BattleBros shared schema definitions",
  "definitions": {
    "uintString": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "intString": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "nullableUintString": { "anyOf": [{ "$ref": "#/definitions/uintString" }, { "type": "null" }] },
    "nullableAddress": { "anyOf": [{ "$ref": "#/definitions/address" }, { "type": "null" }] },
    "nullableBytes32": { "anyOf": [{ "$ref": "#/definitions/bytes32" }, { "type": "null" }] },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "blockNumber", "blockHash", "timestamp"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "blockNumber": { "$ref": "#/definitions/uintString" },
        "blockHash": { "$ref": "#/definitions/bytes32" },
        "timestamp": { "$ref": "#/definitions/uintString" }
      }
    },
    "documentIdentity": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "chainId": { "$ref": "#/definitions/uintString" },
        "battleManagerAddress": { "$ref": "#/definitions/address" },
        "snapshot": { "$ref": "#/definitions/snapshot" }
      }
    },
    "eventReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockNumber", "transactionHash", "logIndex"],
      "properties": {
        "blockNumber": { "$ref": "#/definitions/uintString" },
        "transactionHash": { "$ref": "#/definitions/bytes32" },
        "logIndex": { "$ref": "#/definitions/uintString" }
      }
    },
    "combatType": { "type": "string", "enum": ["ATTACK", "DEFEND", "COUNTER"] },
    "battleType": { "type": "string", "enum": ["DAILY", "MAJOR", "CHAMPIONSHIP"] },
    "battleBroType": { "type": "string", "enum": ["TYPE_1", "TYPE_2", "TYPE_3", "TYPE_4"] },
    "reserves": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attack", "defend", "counter"],
      "properties": {
        "attack": { "$ref": "#/definitions/uintString" },
        "defend": { "$ref": "#/definitions/uintString" },
        "counter": { "$ref": "#/definitions/uintString" }
      }
    }
  }
}
