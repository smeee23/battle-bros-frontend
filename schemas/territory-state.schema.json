{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "territory-state.schema.json",
  "title": "BattleBros paired territory publication v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chainId",
    "deploymentId",
    "snapshot",
    "contracts",
    "configuration",
    "shareRate",
    "locations",
    "battleBros",
    "challenges",
    "needs",
    "fees",
    "history",
    "scheduledConfiguration",
    "projectionVersion",
    "registrations",
    "registrationConfiguration",
    "scheduledRegistrationConfiguration",
    "sidePools",
    "sideMatches"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "chainId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "deploymentId": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockNumber",
        "blockHash",
        "timestamp"
      ],
      "properties": {
        "blockNumber": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "blockHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "timestamp": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "combat",
        "bros",
        "vault",
        "randomness",
        "needs",
        "stETH",
        "matchmaker"
      ],
      "properties": {
        "combat": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "bros": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "vault": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "randomness": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "needs": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "stETH": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "matchmaker": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        }
      }
    },
    "configuration": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "riskBps",
            "feeBps",
            "minimumBps",
            "defenderBps",
            "timeout",
            "feeRecipient"
          ],
          "properties": {
            "riskBps": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "feeBps": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "minimumBps": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "defenderBps": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "timeout": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "feeRecipient": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "shareRate": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "totalEther",
            "totalShares"
          ],
          "properties": {
            "totalEther": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "totalShares": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locationId",
          "enabled",
          "occupant",
          "nonce",
          "occupiedAt",
          "pendingChallengeId",
          "departing",
          "potShares",
          "minLevel",
          "maxLevel",
          "cooldownUntil"
        ],
        "properties": {
          "locationId": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "enabled": {
            "type": "boolean"
          },
          "occupant": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "nonce": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "occupiedAt": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "pendingChallengeId": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "departing": {
            "type": "boolean"
          },
          "potShares": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "minLevel": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "maxLevel": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "reclaimBlockedTokenId": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "reclaimBlockedOwner": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "cooldownUntil": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        }
      }
    },
    "battleBros": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "tokenId",
          "owner",
          "active",
          "hatchedAt",
          "lastTrainingAt",
          "xp",
          "level",
          "capacity",
          "reserves",
          "projectedReserves",
          "training",
          "defense",
          "defenseNonce",
          "refundable",
          "freeShares",
          "reservedShares",
          "protectedPrincipal",
          "need",
          "locationId",
          "pendingChallengeId",
          "name"
        ],
        "properties": {
          "tokenId": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "active": {
            "type": "boolean"
          },
          "hatchedAt": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "lastTrainingAt": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "xp": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "level": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "capacity": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "reserves": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          },
          "projectedReserves": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          },
          "training": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          },
          "defense": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          },
          "defenseNonce": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "refundable": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "freeShares": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "reservedShares": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "protectedPrincipal": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "need": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "active",
              "sourceEpoch",
              "activeSinceTimestamp",
              "materializedOnchain",
              "evaluatedThroughSeedSequence"
            ],
            "properties": {
              "active": {
                "type": "boolean"
              },
              "sourceEpoch": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "UTC epoch for a random Need; decimal zero for a backlog-forfeiture Need; null when inactive."
              },
              "activeSinceTimestamp": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "materializedOnchain": {
                "type": "boolean"
              },
              "evaluatedThroughSeedSequence": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              }
            }
          },
          "locationId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "pendingChallengeId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128,
            "description": "Current cosmetic name, limited to 128 UTF-8 bytes onchain. Null for unhatched or legacy unnamed tokens; burned tokens retain their last indexed name."
          },
          "defenseLocked": {
            "type": "boolean"
          },
          "defenderXpDay": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "defenderXpEarned": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "remainingDefenderXp": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "riskableYieldWei": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "currentValueWei": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "riskableShares": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        }
      }
    },
    "challenges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "challengeId",
          "location",
          "attacker",
          "defender",
          "requestId",
          "deadline",
          "power",
          "status"
        ],
        "properties": {
          "challengeId": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "location": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "attacker": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "defender": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "requestId": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "deadline": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "power": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "status": {
            "enum": [
              "PENDING",
              "RESOLVED",
              "EXPIRED",
              "REGISTERING"
            ]
          },
          "xpStakeValueWei": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        }
      }
    },
    "needs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch",
        "evaluatedThroughSeedSequence",
        "complete",
        "activeTokenIds",
        "seeds",
        "configurations"
      ],
      "properties": {
        "epoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "evaluatedThroughSeedSequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "complete": {
          "const": true
        },
        "activeTokenIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "configurations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "fees": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "scheduledConfiguration": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effectiveAt",
            "configuration"
          ],
          "properties": {
            "effectiveAt": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "configuration": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "riskBps",
                "feeBps",
                "minimumBps",
                "defenderBps",
                "timeout",
                "feeRecipient"
              ],
              "properties": {
                "riskBps": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "feeBps": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "minimumBps": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "defenderBps": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "timeout": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "feeRecipient": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{40}$"
                }
              }
            }
          }
        }
      ]
    },
    "projectionVersion": {
      "const": 5
    },
    "registrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registrationId",
          "location",
          "defender",
          "openedAt",
          "closesAt",
          "status",
          "count",
          "entries",
          "selectedToken",
          "finalizedAt"
        ],
        "properties": {
          "registrationId": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "location": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "defender": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "openedAt": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "closesAt": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "count": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "requestId": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "deadline": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "selectedIndex": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "finalizedSeedCount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "status": {
            "enum": [
              "REGISTERING",
              "PENDING",
              "RESOLVED",
              "EXPIRED"
            ]
          },
          "entries": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index",
                "owner",
                "token",
                "stakeShares",
                "xpStakeValue",
                "power",
                "capacity",
                "action",
                "sideStakeShares",
                "disposition",
                "matchId"
              ],
              "properties": {
                "index": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "token": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "stakeShares": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "xpStakeValue": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "power": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "capacity": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "action": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "owner": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{40}$"
                },
                "sideStakeShares": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "disposition": {
                  "enum": [
                    "WAITING",
                    "TERRITORY",
                    "ASSIGNED",
                    "SETTLED",
                    "BYE",
                    "EXPIRED"
                  ]
                },
                "matchId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "selectedToken": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "finalizedAt": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "registrationConfiguration": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "duration",
            "cooldown",
            "recoveryBackoff"
          ],
          "properties": {
            "duration": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "cooldown": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "recoveryBackoff": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "scheduledRegistrationConfiguration": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "effectiveAt",
            "configuration"
          ],
          "additionalProperties": false,
          "properties": {
            "effectiveAt": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "configuration": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "duration",
                "cooldown",
                "recoveryBackoff"
              ],
              "properties": {
                "duration": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "cooldown": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "recoveryBackoff": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "sidePools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "poolId",
          "requestId",
          "totalEther",
          "totalShares",
          "remaining",
          "waiting",
          "generated",
          "settled",
          "started",
          "complete"
        ],
        "properties": {
          "poolId": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "requestId": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "totalEther": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "totalShares": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "remaining": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "waiting": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "generated": {
            "type": "string",
